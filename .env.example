# PostgreSQL connection string for the existing TORCAP database.
# Server-side only — Prisma and API routes read this via process.env.
# Never prefix this with NEXT_PUBLIC_, and never reference it from client components.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/torcap?schema=public"

# Optional: a separate, more restricted connection for read-only introspection/reporting.
# SHADOW_DATABASE_URL is only needed if you later run `prisma migrate dev` against a
# database where the Prisma migration user can't create/drop a shadow database itself.
# SHADOW_DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/torcap_shadow?schema=public"

# A long random string used to sign the temporary WhatsApp-OTP cookie during
# login, so it can't be edited in the browser to log in as a different
# customer. Any random 32+ character string works — e.g. generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Must be 32+ random characters. Generate: openssl rand -hex 32
SESSION_SECRET="replace-with-a-long-random-string-at-least-32-chars"

# WhatsApp send credentials (provider URL, username, password, sender,
# priority, timeout) are NOT set here — src/lib/whatsapp.ts reads them
# straight from the `company` table (whatsapp_api_url, whatsapp_username,
# etc.), the same settings TORCAP's main ERP already uses. Manage them
# there, not in this file.
#
# The one thing `company` doesn't have a column for is a template name for
# LOGIN specifically (it only has templates for POS invoices and scheme
# receipts). Set this to whatever template TORCAP's scheme-module OTPs
# already use, or leave it as "otp" (the provider's own documented example
# template name) until you confirm the real one.
WHATSAPP_OTP_TEMPLATE_NAME="otp"
